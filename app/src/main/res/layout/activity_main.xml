<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Intestazione -->

    <!-- Avvio Automatico -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="GhostSync"
        android:textColor="#1DB954"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switchAutoStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="Avvio Automatico in background (experimental), suggest to keep it on"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:thumbTint="#1DB954"
        android:trackTint="#4D1DB954" />

    <!-- Pulsante Permessi -->
    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="14dp"
        android:text="Apri Permessi Notifiche"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#333333" />

    <!-- Etichetta lista app -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:text="Da quali app copiare la musica?"
        android:textColor="#B3B3B3"
        android:textSize="14sp" />

    <!-- Lista App -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="14dp"
        android:background="#282828"
        android:padding="10dp" />

    <!-- Etichetta mini player -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:text="Mini Player (Login / Debug), fai il login e accetta i cookies, attendi poi fino al caricamento della pagina"
        android:textColor="#B3B3B3"
        android:textSize="14sp" />

    <!-- Mini Player -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        app:cardBackgroundColor="#282828"
        app:cardCornerRadius="12dp">

        <WebView
            android:id="@+id/loginWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212" />

    </androidx.cardview.widget.CardView>

</LinearLayout>